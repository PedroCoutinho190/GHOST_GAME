/** Logica de derrota: tela de 'Game Over' e utilitario de texto centralizado */
class GameOver {

   /**
    * Mostra a tela de Game Over.
    * result: 1 = fantasma pegou a pessoa, 2 = tempo acabou (pessoa escapou)
    */
   function void show(int result) {
      do Sys.wait(700);               // deixa ver o momento final antes de limpar
      do Screen.clearScreen();
      do GameOver.drawFrame();
      do GameOver.printCentered(5, "G A M E   O V E R");

      if (result = 1) {
         do GameOver.printCentered(8, "O fantasma pegou a pessoa!");
         do GameOver.printCentered(10, "Vencedor: Jogador 1 (Fantasma)");
      }
      if (result = 2) {
         do GameOver.printCentered(8, "O tempo acabou! A pessoa escapou!");
         do GameOver.printCentered(10, "Vencedor: Jogador 2 (Pessoa)");
      }
      return;
   }

   /** Desenha uma moldura (linhas de 2 pixels) em volta da tela de Game Over */
   function void drawFrame() {
      do Screen.setColor(true);
      do Screen.drawRectangle(64, 33, 447, 34);     // topo
      do Screen.drawRectangle(64, 197, 447, 198);   // base
      do Screen.drawRectangle(64, 33, 65, 198);     // esquerda
      do Screen.drawRectangle(446, 33, 447, 198);   // direita
      return;
   }

   /**
    * Imprime o texto centralizado na linha informada (tela de texto: 23 linhas x 64 colunas).
    * Usar SOMENTE com literais de string: a string e liberada da memoria no final.
    */
   function void printCentered(int row, String s) {
      var int col;
      let col = (64 - s.length()) / 2;
      do Output.moveCursor(row, col);
      do Output.printString(s);
      do s.dispose();
      return;
   }
}
