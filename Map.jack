/**
 * Map: o MAPA do jogo (paredes, corredores e labirinto).
 * Grade de 32 colunas x 15 linhas, cada celula com 16x16 pixels.
 * A primeira faixa da tela (y = 0..15) fica reservada para o HUD (relogios).
 * '#' = parede, '.' = chao livre.
 */
class Map {
    field Array rows;   // 15 Strings de 32 caracteres
    field int numCols, numRows;

    constructor Map new() {
        let numCols = 32;
        let numRows = 15;
        let rows = Array.new(15);
        do buildMap();
        return this;
    }

    /** Monta o mapa fixo. Todo chao e alcancavel a partir de qualquer outro chao. */
    method void buildMap() {
        let rows[0]  = "################################";
        let rows[1]  = "#..............................#";
        let rows[2]  = "#.#####.#######.######.#######.#";
        let rows[3]  = "#.#####.#######.######.#######.#";
        let rows[4]  = "#..............................#";
        let rows[5]  = "#.######.#####.########.######.#";
        let rows[6]  = "#.######.#####.########.######.#";
        let rows[7]  = "#.........#..........#.........#";
        let rows[8]  = "#.####.########.#####.########.#";
        let rows[9]  = "#.####.########.#####.########.#";
        let rows[10] = "#..............................#";
        let rows[11] = "#.#####.#######.######.#######.#";
        let rows[12] = "#.#####.#######.######.#######.#";
        let rows[13] = "#..............................#";
        let rows[14] = "################################";
        return;
    }

    /** Limpa a tela e desenha as paredes (agrupa paredes seguidas numa linha so, para ser rapido). */
    method void draw() {
        var int r, c, start;
        var boolean more;
        var String line;

        do Screen.clearScreen();
        do Screen.setColor(true);
        let r = 0;
        while (r < numRows) {
            let line = rows[r];
            let c = 0;
            while (c < numCols) {
                if (line.charAt(c) = 35) {          // 35 = '#'
                    let start = c;
                    let more = true;
                    while (more) {                  // avanca ate o fim da sequencia de paredes
                        let c = c + 1;
                        if (c = numCols) {
                            let more = false;
                        } else {
                            if (~(line.charAt(c) = 35)) { let more = false; }
                        }
                    }
                    do Screen.drawRectangle(start * 16, 16 + (r * 16), (c * 16) - 1, (16 + (r * 16)) + 15);
                } else {
                    let c = c + 1;
                }
            }
            let r = r + 1;
        }
        return;
    }

    /** true se a celula (col,row) e parede ou esta fora do mapa. */
    method boolean isWall(int col, int row) {
        var String line;
        if ((col < 0) | (~(col < numCols))) { return true; }
        if ((row < 0) | (~(row < numRows))) { return true; }
        let line = rows[row];
        return (line.charAt(col) = 35);
    }

    method int getCols() { return numCols; }
    method int getRows() { return numRows; }

    method void dispose() {
        var int i;
        var String line;
        let i = 0;
        while (i < numRows) {
            let line = rows[i];
            do line.dispose();
            let i = i + 1;
        }
        do rows.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
