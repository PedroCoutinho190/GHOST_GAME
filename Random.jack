/**
Referência: http://nand2tetris-questions-and-answers-forum.32033.n3.nabble.com/Random-number-generator-for-hack-cpu-td4025503.html#a4025511

Como não existe um gerador de números aleatórios nativo na linguagem Jack,
precisamos gerar números pseudoaleatórios por conta própria.
Esta classe implementa um gerador simples.

Melhoria: torna o número mais aleatório adicionando um fator de deslocamento (shift).
**/

class Random {
    field int seed;       // semente do gerador
    field int calledTime; // contador de chamadas

    constructor Random new(int seedIn) {
        let seed = seedIn;
        let seed = rand();
        let calledTime = 0;
        return this;
    }

    /** Retorna um numero aleatorio no intervalo de 0 a 32767 */
    method int rand() {
        let seed = seed + 20251;

        if (seed < 0) {
            let seed = seed - 32767 - 1;
        }

        return seed;
    }

    /** Retorna um numero aleatorio no intervalo de 0 ate range */
    method int randRange(int range) {
        var int mask;
        var int ret;

        let mask = 1;
        while (mask < range) {
            let mask = mask * 2 + 1;
        }

        let ret = rand() & mask;
        let calledTime = calledTime + 1;

        while (ret > range) {
            let ret = rand() & mask;
            let calledTime = calledTime + 1;
            let ret = ret & getShift();
        }

        return ret;
    }

    // Calcula um novo fator de deslocamento com base no numero de chamadas
    method int getShift() {
        var int temp;

        let calledTime = calledTime + 1;
        let temp = calledTime;
        
        while(temp > 9){
            let temp = temp - 9;
        }

        return temp;
    }

    // Libera o objeto da memoria
    method void dispose(){
        do Memory.deAlloc(this);
        return;
    }

    // Atualiza o contador de chamadas
    method void addCallTime(int times){
        let calledTime = calledTime + times;
        return;
    }
}